{
  "name": "pi-distill",
  "version": "0.1.0",
  "private": true,
  "description": "Adaptive memory and context for Pi.",
  "license": "MIT",
  "type": "module",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "test": "node --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "test:model": "node tests/model/memory-model-eval.mjs",
    "test:model:consolidation": "node tests/model/consolidation-model-eval.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "22.19.19",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "author": "dyxcode",
  "repository": {
    "type": "git",
    "url": "https://github.com/dyxcode/pi-distill.git"
  },
  "homepage": "https://github.com/dyxcode/pi-distill#readme",
  "bugs": {
    "url": "https://github.com/dyxcode/pi-distill/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "memory"
  ],
  "files": [
    "src/**/*.ts",
    "docs/*.md",
    "docs/i18n/*.md",
    "docs/assets/*.svg",
    "README.md",
    "LICENSE"
  ]
}
